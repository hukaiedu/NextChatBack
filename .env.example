NODE_ENV=development
HOST=127.0.0.1
PORT=3010
DATABASE_URL="file:./data/database/app.db"
LOG_LEVEL=info
BROWSER_PROFILE_DIR=./data/browser-profile
BROWSER_HEADLESS=false
# 可选:显式浏览器代理(仅 Playwright Chromium 使用;V1 仅 http/https/socks5,不含账号密码)
# 未设置 = 不传 proxy(Windows 开发环境 Chromium 继承系统代理)。
# 服务器部署时 127.0.0.1 指服务器自己,不要写开发机 IP。
# BROWSER_PROXY_URL=http://127.0.0.1:7892
# BROWSER_PROXY_URL=socks5://127.0.0.1:7892
GEMINI_BASE_URL=https://gemini.google.com/app
GEMINI_RESPONSE_TIMEOUT_MS=300000
REQUEST_EXECUTION_TIMEOUT_MS=600000
STREAMING_UPDATE_INTERVAL_MS=300
# AUTH_ENABLED=false = 免鉴权兼容模式,只允许 HOST 为 loopback(127.0.0.1/::1/localhost);
# 绑 0.0.0.0 或对公网监听必须改为 true(V1.3 fail-closed)
AUTH_ENABLED=false
# ADMIN Session TTL(秒,滑动续期上限)
AUTH_SESSION_TTL_SECONDS=604800
# ANONYMOUS Session TTL(秒,默认 30 天)
AUTH_SESSION_TTL_ANONYMOUS_SECONDS=2592000
# 滑动续期阈值(秒):lastSeenAt 距 now 超过该间隔才写库续期并重发 Set-Cookie
AUTH_SESSION_TOUCH_INTERVAL_SECONDS=3600
AUTH_TRUST_PROXY=false
# AUTH_ENABLED=true 时必填:共享密码 min 12 字符(V1.3 起不再需要 AUTH_SESSION_SECRET)
# AUTH_PASSWORD=
# 逗号分隔 Origin 白名单(production 且 AUTH_ENABLED=true 时必填且每项必须 https)
# AUTH_ALLOWED_ORIGINS=https://chat.example.com
#
# —— V1.3 P6 入口防刷与排队容量(全部内存态,进程重启即清零;不进数据库)——
# 同一 IP 每小时/每 24 小时可「新建」多少个匿名身份(范围 1~10000 / 1~100000)。
# 只保护创建:带着有效 Cookie 反复调用 /api/auth/anonymous 不消耗额度。
AUTH_ANONYMOUS_IP_LIMIT_PER_HOUR=20
AUTH_ANONYMOUS_IP_LIMIT_PER_DAY=100
# 单用户每分钟提交消息上限(范围 1~10000)。键是登录身份,不是 IP;ADMIN 与兼容模式同样受限。
CHAT_SUBMIT_RATE_LIMIT_PER_MINUTE=30
# 单用户排队(PENDING)条数上限(范围 1~100)与全库排队上限(范围 1~10000)。
# 计数以数据库为准,因此重启后残留的排队请求仍然占额度。
USER_MAX_PENDING_REQUESTS=5
GLOBAL_MAX_PENDING_REQUESTS=100
# 单用户同时在飞(PROCESSING/CANCELLING)上限(范围 1~10)。
# 计数同样以数据库为准:该用户已达上限时 Scheduler 不再派发他新的 PENDING(改由下一轮对账重试),
# 其它用户照常轮转 —— 它是 per-user 上限,不是全局并行度。
# 当前部署是一个 Gemini 页面 = 一个 worker,调大它不会提高并行度。
USER_MAX_ACTIVE_REQUESTS=1
