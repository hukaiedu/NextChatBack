generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

/// 业务会话(不区分 provider 会话来源,provider URL 可空映射)
model Conversation {
  id                      String    @id @default(uuid())
  title                   String
  status                  String    @default("ACTIVE")
  provider                String    @default("GEMINI_WEB")
  providerConversationUrl String?   @unique
  /// M1:用户在会话维度显式选择的模型键(provider 机器键,如 data-mode-id);null = 未指定
  preferredModelKey       String?
  /// V1.3-B4:归属用户,必填且**没有默认值** —— owner 只能由运行期 req.auth.userId 显式写入,
  /// 忘写必须失败,绝不能静默归给 ADMIN。
  userId                  String
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  deletedAt               DateTime?

  user     User         @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  messages Message[]
  requests ModelRequest[]

  @@index([status])
  @@index([updatedAt])
  @@index([userId, status, updatedAt])
}

model Message {
  id             String   @id @default(uuid())
  conversationId String
  role           String
  content        String
  status         String
  position       Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  conversation     Conversation  @relation(fields: [conversationId], references: [id])
  userRequests     ModelRequest[] @relation("UserMessage")
  assistantRequests ModelRequest[] @relation("AssistantMessage")

  @@unique([conversationId, position])
  @@index([conversationId])
}

/// 一次 User Message → Provider → Assistant Message 的执行记录
model ModelRequest {
  id                   String   @id @default(uuid())
  conversationId       String
  userMessageId        String
  assistantMessageId   String
  idempotencyKey       String   @unique
  requestFingerprint   String
  status               String
  provider             String   @default("GEMINI_WEB")
  /// M1:创建时客户端显式提交的模型键快照(未提交则为 null,创建后不再变更)
  requestedModelKey    String?
  /// M1:实际执行的模型键(由 ensureModel 解析;M1 仅落库,M2 写入)
  resolvedModelKey     String?
  /// M1:实际执行模型的展示名(如 "3.6 Flash";M1 仅落库,M2 写入)
  resolvedModelLabel   String?
  attemptCount         Int      @default(0)
  /// V1.2 I1:本次请求的附件份数。字节只活在内存(AttachmentStore),永不落库;0 = 纯文本
  attachmentCount      Int      @default(0)
  errorCode            String?
  errorMessage         String?
  startedAt            DateTime?
  completedAt          DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  conversation     Conversation @relation(fields: [conversationId], references: [id])
  userMessage      Message      @relation("UserMessage", fields: [userMessageId], references: [id])
  assistantMessage Message      @relation("AssistantMessage", fields: [assistantMessageId], references: [id])

  @@index([conversationId])
  @@index([status])
}

/// V1.3:统一身份主体。B1 只建结构;签发/读取/续期逻辑属 B2
model User {
  id                 String   @id @default(uuid())
  /// ANONYMOUS / REGISTERED / ADMIN(DDL 里为 CHECK 约束)
  type               String   @default("ANONYMOUS")
  /// ACTIVE / DISABLED(DDL 里为 CHECK 约束)
  status             String   @default("ACTIVE")
  /// V1.4 U1:登录名,保留用户输入的展示大小写;仅 REGISTERED 非空
  username           String?
  /// V1.4 U1:归一化(ASCII 小写)登录名,唯一约束的真相源;仅 REGISTERED 非空
  usernameNormalized String?  @unique
  /// V1.4 U1:口令摘要串(自描述格式;具体算法与写入点属 U2);明文永不落库
  passwordHash       String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  sessions      Session[]
  conversations Conversation[]
}

/// V1.3:服务端会话。token 本体只在浏览器,库内只存 sha256 摘要(不可逆)
model Session {
  id         String   @id @default(uuid())
  userId     String
  /// sha256(opaque token) hex(64)
  tokenHash  String   @unique
  expiresAt  DateTime
  lastSeenAt DateTime
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId])
  @@index([expiresAt])
}
