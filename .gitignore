# dependencies
node_modules/

# build output
dist/

# environment (keep .env.example)
.env
.env.*
!.env.example

# runtime data (keep directory placeholders)
data/*
!data/.gitkeep
!data/database/
!data/browser-profile/
!data/debug/
data/database/*
!data/database/.gitkeep
data/browser-profile/*
!data/browser-profile/.gitkeep
data/debug/*
!data/debug/.gitkeep

# logs
logs/*
!logs/.gitkeep
*.log

# project-level skills (reinstallable from GitHub)
.claude/skills/
.qoder/skills/

# personal agent instructions, local only
AGENTS.md

# generated docs / baseline reports
docs/

# IDE
.idea/

# acceptance harness & evidence (kept on disk, intentionally not versioned per project SCM convention)
scripts/acceptance/
acceptance-artifacts/
data/acceptance/

# local acceptance artifacts and one-off verification scripts
/artifacts-*/
scripts/probe-*.ts
scripts/probe-*.mjs
scripts/probe-*.ps1
scripts/seed-*.ts
scripts/sample-*.ts
scripts/verify-*.ts
